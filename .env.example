# GEO-Industry-Engine 环境变量示例
# 复制此文件为 .env 并填入实际值

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://geo_user:changeme@localhost:5432/geo_industry_engine
DATABASE_URL_SYNC=postgresql://geo_user:changeme@localhost:5432/geo_industry_engine
REDIS_URL=redis://localhost:6379/0

# === 认证 ===
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === 应用 ===
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# === AI/LLM (可选) ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# === 外部服务 (可选) ===
# SENTRY_DSN=https://...
# ANALYTICS_ID=G-XXXXXXXX

# === 邮件 (可选) ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=...

# === 部署 ===
# PORT=8000
# HOST=0.0.0.0
# WORKERS=4